# ==============================================================================
# BuildSync Frontend Environment Configuration Template
# For local development: copy to .env.local
# For Vercel production: configure in Vercel Project Settings > Environment Variables
# ==============================================================================

# Backend REST API Base URL
# Development: http://localhost:8080
# Production: https://api.buildsync.dev (or your production backend domain)
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Real-Time WebSocket / STOMP Broker URL (Optional: auto-derived from API URL if omitted)
# Development: ws://localhost:8080/ws
# Production: wss://api.buildsync.dev/ws
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws
