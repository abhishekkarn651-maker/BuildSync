digraph BuildSyncArchitecture {
  graph [rankdir=TB, bgcolor="#F7F9FC", pad="0.45", nodesep="0.7", ranksep="0.75", splines=polyline, fontname="Arial", labelloc="t", label="BUILDSYNC — FINAL SYSTEM ARCHITECTURE (V1)", fontsize=22, fontcolor="#172B4D"];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=11, color="#B7C8DA", penwidth=1.25, margin="0.22,0.16", fontcolor="#172B4D"];
  edge [fontname="Arial", fontsize=9, color="#60758A", penwidth=1.3, arrowsize=0.75];

  browser [label="USER / BROWSER\nDesktop • Tablet • Mobile", fillcolor="#EAF2FF", color="#6C91C5", width=3.2];

  nextjs [label="FRONTEND — Next.js + TypeScript\nApp Router • Responsive UI • Forms • Client interactions\nPublic pages / SEO • Dashboard screens", fillcolor="#DDEBFF", color="#6C91C5", width=5.4];

  backend [label="BACKEND — Java + Spring Boot (MODULAR MONOLITH)\nREST API: /api/v1     |     WebSocket: /ws (STOMP)\n\nModules: Auth & Security • Developer Profiles • Skills & Discovery\nProjects • Collaboration • Notifications • Chat • GitHub Integration\n\nValidation • DTOs • Service layer • Repositories • Transactions", fillcolor="#DDF3E9", color="#5A9F83", width=7.2];

  {rank=same; nextjs; backend;}
  browser -> nextjs [label="HTTPS page requests"];
  browser -> backend [label="HTTPS REST + WSS chat"];
  nextjs -> backend [label="server-side data calls", style=dashed];

  postgres [label="POSTGRESQL\nPrimary relational database\nUsers • Profiles • Skills • Projects\nMembers • Requests • Notifications • Messages", shape=cylinder, fillcolor="#FFF0D9", color="#C99A5A", width=3.6];
  storage [label="S3-COMPATIBLE OBJECT STORAGE\nProfile avatars • Project screenshots\nPresigned upload / download URLs", shape=folder, fillcolor="#FFF0D9", color="#C99A5A", width=3.3];
  github [label="GITHUB API\nServer-side OAuth • Public repositories", shape=component, fillcolor="#FFF0D9", color="#C99A5A", width=2.9];
  {rank=same; postgres; storage; github;}
  backend -> postgres [label="Spring Data JPA / Flyway migrations"];
  backend -> storage [label="media upload / retrieval"];
  backend -> github [label="OAuth + GitHub REST API"];

  note [label="DEPLOYMENT SHAPE\nFrontend host + Spring Boot application + managed PostgreSQL + object storage\nHTTPS everywhere • secrets in environment/secret manager • no database access from browser", shape=note, fillcolor="#FFFFFF", color="#B7C8DA", fontsize=10, width=7.2];
  postgres -> note [style=invis];
  storage -> note [style=invis];
  github -> note [style=invis];
}
