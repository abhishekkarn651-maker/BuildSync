# http://editorconfig.org
root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{java,groovy}]
indent_size = 4

[*.{yml,yaml,json,md,css,scss,html,js,jsx,ts,tsx}]
indent_size = 2

[Makefile]
indent_style = tab
