# ==============================================================================
# BuildSync Environment Configuration Template
# Copy this file to .env and configure values before starting services.
# NEVER commit real credentials or production secrets to source control.
# ==============================================================================

# Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/buildsync_db
DB_USERNAME=buildsync_app
DB_PASSWORD=your_secure_db_password_here

# JWT Authentication Security (Minimum 256 bits / 32 bytes required)
# Generate using: openssl rand -base64 48
JWT_SECRET=your_cryptographically_secure_256_bit_secret_key_here_min_32_bytes
JWT_EXPIRATION_SECONDS=900

# Cookie & Session Security
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
REFRESH_TOKEN_NORMAL_DAYS=7
REFRESH_TOKEN_REMEMBER_ME_DAYS=30

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Server Port
SERVER_PORT=8080

# GitHub App Integration
GITHUB_APP_CLIENT_ID=your_github_app_client_id_here
GITHUB_APP_CLIENT_SECRET=your_github_app_client_secret_here
GITHUB_APP_CALLBACK_URL=http://localhost:8080/api/v1/integrations/github/callback
GITHUB_FRONTEND_REDIRECT_URL=http://localhost:3000/settings/integrations/github
GITHUB_TOKEN_ENCRYPTION_KEY=your_32_byte_aes_gcm_token_encryption_key_here

# Rate Limiting & Redis Configuration
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE=memory
TRUSTED_PROXY_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TIMEOUT_MS=2000


